{
  "name": "@compact-design/html",
  "version": "0.3.0",
  "description": "HTML and CSS renderer for Compact Design JSON.",
  "license": "MPL-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "compact-design-html": "./scripts/render.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "scripts/render.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elliot727/compact-design.git",
    "directory": "packages/html"
  },
  "homepage": "https://github.com/Elliot727/compact-design/tree/main/packages/html#readme",
  "bugs": {
    "url": "https://github.com/Elliot727/compact-design/issues"
  },
  "keywords": [
    "compact-design",
    "html",
    "css",
    "renderer"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/lint.mjs",
    "render": "node scripts/render.mjs"
  },
  "dependencies": {
    "@compact-design/core": "0.3.0"
  }
}
