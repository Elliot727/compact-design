{
  "name": "@compact-design/core",
  "version": "0.2.0",
  "description": "Reusable parser, normalizer, validator, patch engine, and linter for Compact Design JSON.",
  "license": "MPL-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elliot727/compact-design.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Elliot727/compact-design/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Elliot727/compact-design/issues"
  },
  "keywords": [
    "compact-design",
    "design",
    "json",
    "schema",
    "linter"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate:schema": "node scripts/generate-schema.mjs",
    "build": "npm run generate:schema && node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "npm run generate:schema && node scripts/test.mjs",
    "typecheck": "npm run generate:schema && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "node scripts/lint.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
